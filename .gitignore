# Contains real helpers' personal data (names, emails, phone numbers) —
# never commit. Kept on disk for the tool to read/write, just not tracked.
# Unanchored (no leading slash) so it also catches a "data/" dir created
# anywhere by accident, e.g. `rostering serve` run with the wrong cwd —
# not just the intended one at the repo root.
data/

# Claude Code harness state, not project content, except skills, which
# are project tooling meant to be shared and discovered by future agents.
/.claude/*
!/.claude/skills/
# ...except symlinks a package (e.g. streamlit) installs into the venv and
# the harness auto-links in — not project content, and the link target
# (inside .venv/) wouldn't exist on another checkout anyway.
/.claude/skills/developing-with-streamlit
/.agents/

__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/
roster.xlsx
*.tmp.xlsx

node_modules/

# The assignment-grid custom Streamlit component's built JS/CSS bundle IS
# committed (see README.md "Setup") so installing the two editable packages
# is enough to run the app — no Node/npm needed unless editing its JS.
# Override the blanket "build/" rule above just for it.
!components/rostering-assignment-grid/rostering_assignment_grid/frontend/build/
!components/rostering-assignment-grid/rostering_assignment_grid/frontend/build/**
