# Contains real helpers' personal data (names, emails, phone numbers) —
# never commit. Kept on disk for the tool to read/write, just not tracked.
# Unanchored (no leading slash) so it also catches a "data/" dir created
# anywhere by accident, e.g. `rostering serve` run with the wrong cwd —
# not just the intended one at the repo root.
data/

# Claude Code harness state, not project content, except skills, which
# are project tooling meant to be shared and discovered by future agents.
/.claude/*
!/.claude/skills/

__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/
roster.xlsx
*.tmp.xlsx

node_modules/
